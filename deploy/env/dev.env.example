# ============================================================================
# hero-quant dev（本机）
#
# 注意：日常开发**不用**这个文件，用仓库根的 docker-compose.yml + .env
# （复用宿主 llm-pg/llm-redis，见 README「Docker 单机部署」）。
#
# 本模板只用于在本机冒烟验证生产编排（prod compose）而不占用 80/443、
# 不碰生产目录：端口 9080/9443，数据/备份/状态全部落 /tmp。
#
#   cp deploy/env/dev.env.example /tmp/hero-quant-dev.env
#   HERO_ENV_FILE=/tmp/hero-quant-dev.env \
#     docker compose -f deploy/compose/docker-compose.prod.yml --profile blue config
#
# HERO_DOMAIN=localhost 时 Caddy 走本地内部 CA，探针需 --insecure，
# 浏览器会提示证书不受信——这是本地冒烟的正常现象，不是缺陷。
# ============================================================================

COMPOSE_PROJECT_NAME=hero-quant-dev
COMPOSE_PROFILES=blue
HERO_IMAGE=hero-quant
HERO_IMAGE_TAG=dev
HERO_DOMAIN=localhost
ACME_EMAIL=dev@localhost
HERO_HTTP_PORT=9080
HERO_HTTPS_PORT=9443
HERO_BACKUP_DIR=/tmp/hero-quant-dev/backups
HERO_CADDY_STATE_DIR=/tmp/hero-quant-dev/caddy
HERO_DEPLOY_STATE_DIR=/tmp/hero-quant-dev/deploy
# dev 不评估 SLO（本机盘也扛不住 30d），预算规则在 dev 上的值不可信
HERO_PROM_RETENTION=1d
HERO_PROM_PORT=9092
HERO_AM_PORT=9095
HERO_GRAFANA_PORT=3002
GRAFANA_ADMIN_PASSWORD=devpassword123
BACKUP_KEEP_DAYS=3
WAL_KEEP_DAYS=7
MIGRATE_ALLOW_LEGACY_BOOTSTRAP=1
HERO_VERIFY_URL=

POSTGRES_USER=heroquant
POSTGRES_PASSWORD=devpassword123
POSTGRES_DB=heroquant
REDIS_PASSWORD=devpassword123
HERO_DB_DSN=postgresql://heroquant:devpassword123@postgres:5432/heroquant
HERO_REDIS_DSN=redis://:devpassword123@redis:6379/0

HERO_ENV=development
HERO_LLM_PROVIDER=openai
HERO_API_KEY=
HERO_LLM_MODEL=gpt-4o-mini
COHERE_API_KEY=
PII_ENCRYPTION_KEY=
HERO_READY_COHERE_FATAL=false
HERO_DATA_MODE=synthetic
HERO_DATA_MARKET=CN
HERO_AUTH_MODE=off

KEYCLOAK_ADMIN=
KEYCLOAK_ADMIN_PASSWORD=
