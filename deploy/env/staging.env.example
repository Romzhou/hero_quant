# ============================================================================
# hero-quant staging（同机独立目录 + 端口，PR-165）
#
# 与 prod 的隔离点：
#   - 独立 compose project（容器/网络/卷名全隔离）
#   - 独立宿主端口 8080/8443
#   - 独立 env / 备份 / 状态目录（密钥不复用）
#
# 安装：install -d -m 700 /etc/hero-quant
#       install -m 600 deploy/env/staging.env.example /etc/hero-quant/hero-quant-staging.env
# 启动：HERO_ENV_FILE=/etc/hero-quant/hero-quant-staging.env \
#       docker compose -f deploy/compose/docker-compose.prod.yml --profile blue up -d
#
# 字段含义与 prod.env.example 完全一致，只有值不同。
# ============================================================================

COMPOSE_PROJECT_NAME=hero-quant-staging
COMPOSE_PROFILES=blue
HERO_IMAGE=ghcr.io/your-org/hero-quant
HERO_IMAGE_TAG=replace-with-immutable-tag
# staging 子域名；用本地 CA 时改成 localhost（见 deploy/README.md）
HERO_DOMAIN=staging.quant.example.com
ACME_EMAIL=ops@example.com
HERO_HTTP_PORT=8080
HERO_HTTPS_PORT=8443
HERO_BACKUP_DIR=/var/backups/hero-quant-staging
HERO_CADDY_STATE_DIR=/var/lib/hero-quant-staging/caddy
HERO_DEPLOY_STATE_DIR=/var/lib/hero-quant-staging/deploy
BACKUP_KEEP_DAYS=3
WAL_KEEP_DAYS=7
MIGRATE_ALLOW_LEGACY_BOOTSTRAP=1
HERO_VERIFY_URL=

POSTGRES_USER=heroquant_staging
POSTGRES_PASSWORD=replace-with-32-alnum
POSTGRES_DB=heroquant_staging
REDIS_PASSWORD=replace-with-32-alnum
HERO_DB_DSN=postgresql://heroquant_staging:replace-with-32-alnum@postgres:5432/heroquant_staging
HERO_REDIS_DSN=redis://:replace-with-32-alnum@redis:6379/0

HERO_ENV=staging
HERO_LLM_PROVIDER=openai
HERO_API_KEY=
HERO_LLM_MODEL=gpt-4o-mini
COHERE_API_KEY=
PII_ENCRYPTION_KEY=
HERO_READY_COHERE_FATAL=false
HERO_DATA_MODE=live
HERO_DATA_MARKET=CN

# W1 接线前保持 off（缺省会强制 enforce）；staging 用独立 realm 演练后再改 enforce
HERO_AUTH_MODE=off
HERO_OIDC_ISSUER=https://auth.staging.quant.example.com/realms/hero-quant
HERO_OIDC_AUDIENCE=hero-quant-api
HERO_OIDC_JWKS_URL=
HERO_OIDC_ALGORITHMS=RS256
HERO_TENANT_REQUESTS_PER_MINUTE=60
HERO_TENANT_DAILY_TOKEN_BUDGET=2000000

KEYCLOAK_ADMIN=
KEYCLOAK_ADMIN_PASSWORD=
