# ============================================================================
# hero-quant 生产环境变量（PR-161~165）
#
#   安装：install -d -m 700 /etc/hero-quant
#         install -m 600 deploy/env/prod.env.example /etc/hero-quant/hero-quant.env
#         编辑后运行 scripts/deploy/preflight.sh --init-dirs
#
# 同一个文件被三方读取：docker compose 插值 / systemd EnvironmentFile /
# scripts/deploy/lib.sh source。因此必须是 shell 兼容的 KEY=value：
#   - 值不要加引号，不要含空格、$、反引号、#；
#   - 口令只用 A-Za-z0-9._-（建议 32 位随机字母数字），preflight 会校验；
#   - 绝不提交真值，绝不把本文件复制回仓库。
#
# 改口令时 POSTGRES_PASSWORD 与 HERO_DB_DSN、REDIS_PASSWORD 与 HERO_REDIS_DSN
# 必须同步修改（systemd 不做变量展开，不能写 ${...}）。
# ============================================================================

# --- 部署层（应用不读） ------------------------------------------------------
# HERO_ENV_FILE 由 systemd / scripts 提供（`export HERO_ENV_FILE=/etc/hero-quant/hero-quant.env`），
# 不写在本文件里，否则用模板自身做 config 校验时会自我重定向。
COMPOSE_PROJECT_NAME=hero-quant
# 当前接流量的颜色；bluegreen.sh 会同步 systemd drop-in，一般不用手改
COMPOSE_PROFILES=blue
HERO_IMAGE=ghcr.io/your-org/hero-quant
# 只允许不可变 tag（git sha / vX.Y.Z）；deploy.sh 拒绝 latest
HERO_IMAGE_TAG=replace-with-immutable-tag
HERO_DOMAIN=quant.example.com
ACME_EMAIL=ops@example.com
HERO_HTTP_PORT=80
HERO_HTTPS_PORT=443
HERO_BACKUP_DIR=/var/backups/hero-quant
HERO_CADDY_STATE_DIR=/var/lib/hero-quant/caddy
HERO_DEPLOY_STATE_DIR=/var/lib/hero-quant/deploy
# 观测 profile：Prometheus 只绑回环，保留期按磁盘容量调
# >=35d：slo.yml 的错误预算用 30 天窗口，小于 30d 会算出偏小/空的值（docs/slo.md 硬前提）
HERO_PROM_RETENTION=35d
HERO_PROM_PORT=9090
HERO_AM_PORT=9093
HERO_GRAFANA_PORT=3000
# Grafana 初始 admin 口令，登录后立即改；模板值必须替换
GRAFANA_ADMIN_PASSWORD=replace-with-32-alnum
BACKUP_KEEP_DAYS=14
# 必须 >= BACKUP_KEEP_DAYS，否则 PITR 断档
WAL_KEEP_DAYS=30
# W4 版本化迁移（PR-133）合入前允许幂等 baseline；合入后必须改成 0
MIGRATE_ALLOW_LEGACY_BOOTSTRAP=1
# 可选：切流后从公网再验一次 /ready（如 https://quant.example.com/ready）
HERO_VERIFY_URL=

# --- 数据层 ------------------------------------------------------------------
POSTGRES_USER=heroquant
POSTGRES_PASSWORD=replace-with-32-alnum
POSTGRES_DB=heroquant
REDIS_PASSWORD=replace-with-32-alnum
HERO_DB_DSN=postgresql://heroquant:replace-with-32-alnum@postgres:5432/heroquant
HERO_REDIS_DSN=redis://:replace-with-32-alnum@redis:6379/0

# --- 应用（其余键见仓库根 .env.example，按需追加） ---------------------------
HERO_ENV=production
HERO_LLM_PROVIDER=openai
HERO_API_KEY=
HERO_LLM_MODEL=gpt-4o-mini
COHERE_API_KEY=
PII_ENCRYPTION_KEY=
HERO_READY_COHERE_FATAL=false
HERO_DATA_MODE=live
HERO_DATA_MARKET=CN

# --- 身份 / OIDC（W1 字段，settings.py:446-454）--------------------------------
# W1 的 server.py 接线完成前必须先保持 off，否则 JWKS 未配时验签直接失败。
# **G1 发布门**：preflight.sh 会在 HERO_ENV=production 且这里不是 enforce 时直接判 FAIL
# （临时放行要显式写 HERO_ALLOW_AUTH_OFF=1 并在发布记录里写明原因）。
HERO_AUTH_MODE=off
HERO_OIDC_ISSUER=https://auth.quant.example.com/realms/hero-quant
HERO_OIDC_AUDIENCE=hero-quant-api
# 留空则由 issuer 推导 <issuer>/protocol/openid-connect/certs（settings.py:342-350）
HERO_OIDC_JWKS_URL=
HERO_OIDC_ALGORITHMS=RS256
HERO_OIDC_LEEWAY_SECONDS=60
HERO_OIDC_JWKS_TTL_SECONDS=300
HERO_TENANT_REQUESTS_PER_MINUTE=60
HERO_TENANT_DAILY_TOKEN_BUDGET=2000000

# --- Keycloak（可选 profile: auth，默认不启动） ------------------------------
KEYCLOAK_ADMIN=
KEYCLOAK_ADMIN_PASSWORD=
