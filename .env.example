# hero-quant 环境示例 — 复制为 .env 后填入真实密钥
# cp .env.example .env

# LLM
HERO_LLM_PROVIDER=openai
HERO_API_KEY=sk-...
HERO_LLM_MODEL=gpt-4o-mini
# 独立模型槽位；留空回退 HERO_LLM_MODEL（settings.py:290-297）
HERO_LLM_MODEL_QUICK=
HERO_LLM_MODEL_DEEP=
COHERE_API_KEY=

# 数据
HERO_DATA_MODE=live
HERO_DATA_MARKET=CN

# 存储 / PG（本地默认 localhost；compose 内主机名经 HERO_PG_HOST 切换，见 settings.py:151-183 网关）
# 显式 HERO_*_DSN 优先于 HERO_PG_HOST；库名统一 heroquant（settings.py:183 默认值同此）
# HERO_PG_USER / HERO_PG_PASSWORD 供 docker-compose.yml 的 DSN 变量插值使用；
# 默认部署复用宿主机既有 PG（100.114.54.26:5432），口令只写在 .env，禁止进仓库。
HERO_PG_HOST=
HERO_PG_USER=
HERO_PG_PASSWORD=
HERO_PG_DSN=
POSTGRES_DSN=postgresql://heroquant:heroquant@localhost:5432/heroquant
CHECKPOINT_DSN=postgresql://heroquant:heroquant@localhost:5432/heroquant
BILLING_DSN=postgresql://heroquant:heroquant@localhost:5432/heroquant
HERO_CHECKPOINT_DSN=postgresql://heroquant:heroquant@localhost:5432/heroquant
HERO_BILLING_DSN=postgresql://heroquant:heroquant@localhost:5432/heroquant
HERO_VECTOR_DSN=postgresql://heroquant:heroquant@localhost:5432/heroquant
# billing 复用 checkpoint 库必须显式打开；未设时 _billing_dsn_from_env 返回 None（fail-closed）
HERO_BILLING_ALLOW_SHARED_DB=
HERO_CHECKPOINT_TTL_SECONDS=604800

# Redis（限流 / ticket / 分布式锁；未配置时 infra/redis.py 走 fail-closed）
# 优先级：HERO_REDIS_DSN > HERO_REDIS_HOST/PORT/PASSWORD/DB > REDIS_URL
HERO_REDIS_DSN=
HERO_REDIS_HOST=
HERO_REDIS_PORT=6379
HERO_REDIS_PASSWORD=
HERO_REDIS_DB=0

# 向量存储（pgvector 需要真 PG；off 时走内存回退）
HERO_VECTOR_STORE=
HERO_VECTOR_ENABLED=
HERO_EMBED_PROVIDER=offline
HERO_VECTOR_DIM=32

# 其他
HERO_BENCHMARK_TICKER=
HERO_WALL_TIME_BUDGET_SECONDS=30
FRONTEND_DIST=frontend/dist

# 审计 / PII / 遥测（PR3-I）
# PII_ENCRYPTION_KEY 由 `python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'` 生成
PII_ENCRYPTION_KEY=
HERO_OTEL_MODE=disabled
OTEL_EXPORTER_OTLP_ENDPOINT=
