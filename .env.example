# hero-quant 环境示例 — 复制为 .env 后填入真实密钥
# cp .env.example .env

# LLM
HERO_LLM_PROVIDER=openai
HERO_API_KEY=sk-...
HERO_LLM_MODEL=gpt-4o-mini
COHERE_API_KEY=

# 数据
HERO_DATA_MODE=live
HERO_DATA_MARKET=CN

# 存储 / PG
POSTGRES_DSN=postgresql://postgres:postgres@localhost:5432/hero_quant
CHECKPOINT_DSN=postgresql://postgres:postgres@localhost:5432/hero_quant
BILLING_DSN=postgresql://postgres:postgres@localhost:5432/hero_quant
HERO_CHECKPOINT_DSN=postgresql://postgres:postgres@localhost:5432/hero_quant
HERO_BILLING_DSN=postgresql://postgres:postgres@localhost:5432/hero_quant
HERO_VECTOR_DSN=postgresql://postgres:postgres@localhost:5432/hero_quant

# 其他
HERO_WALL_TIME_BUDGET_SECONDS=30
FRONTEND_DIST=frontend/dist
