# hero-quant 环境示例 — 复制为 .env 后填入真实密钥
# cp .env.example .env

# LLM
HERO_LLM_PROVIDER=openai
HERO_API_KEY=sk-...
HERO_LLM_MODEL=gpt-4o-mini
# OpenAI 兼容网关根地址（例 http://localhost:3001/v1）；留空走官方 API；仅 http/https。
# 只填地址，凭据仍走 HERO_API_KEY —— 禁止把 key 写进 URL 或提交到仓库。
HERO_LLM_BASE_URL=
# 独立模型槽位；留空回退 HERO_LLM_MODEL（settings.py:290-297）
HERO_LLM_MODEL_QUICK=
HERO_LLM_MODEL_DEEP=
COHERE_API_KEY=

# 数据
HERO_DATA_MODE=live
HERO_DATA_MARKET=CN
# 定价源：catalog（默认，仓内价目）| null（明确关闭，全部记 unpriced，不写 0 元）。
# 未知值直接 ValueError（fail-closed），仅允许这两个值。
HERO_PRICING_BACKEND=catalog

# 按角色拆分的 DSN（批次15；留空则回落 HERO_CHECKPOINT_DSN 的单一角色）
# queue worker 用 hero_queue_worker（跨租户领取靠 TO role 的 RLS 策略，不用 BYPASSRLS）；
# 管理后台只读用 hero_admin_readonly（库里只有 SELECT）。
HERO_QUEUE_WORKER_DSN=
HERO_ADMIN_READONLY_DSN=

# PIT 数据根目录（仓库外，绝对路径；不接受 ~ 展开）。默认 /root/hero-data/pit，
# 目录必须由部署方预先创建且可写：不存在/不可写时 PitParquetStore 直接报错，不会静默 mkdir。
HERO_PIT_ROOT=/root/hero-data/pit

# 存储 / PG（见 settings.py:151-183 网关）
# 主机口径（2026-10-28 决策 D-1）：宿主与容器统一用 100.114.54.26，不再分叉。
#   100.114.54.26 = 本机 tailscale IP；换机器或 IP 变了，改这里的全部主机段。
#   127.0.0.1 / localhost 的 5432、6379 **不通**：llm-pg / llm-redis 只绑 tailscale IP。
# 显式 HERO_*_DSN 优先于 HERO_PG_HOST；库名统一 heroquant（settings.py:183 默认值同此）
# HERO_PG_USER / HERO_PG_PASSWORD 供 docker-compose.yml 的 DSN 变量插值使用；
# 默认部署复用宿主机既有 PG（100.114.54.26:5432），口令只写在 .env，禁止进仓库。
# HERO_PG_USER 取 llm-pg 容器内的 $POSTGRES_USER（不是 postgres）。
HERO_PG_HOST=100.114.54.26
HERO_PG_USER=
HERO_PG_PASSWORD=
HERO_PG_DSN=
POSTGRES_DSN=postgresql://heroquant:heroquant@100.114.54.26:5432/heroquant
CHECKPOINT_DSN=postgresql://heroquant:heroquant@100.114.54.26:5432/heroquant
BILLING_DSN=postgresql://heroquant:heroquant@100.114.54.26:5432/heroquant
HERO_CHECKPOINT_DSN=postgresql://heroquant:heroquant@100.114.54.26:5432/heroquant
HERO_BILLING_DSN=postgresql://heroquant:heroquant@100.114.54.26:5432/heroquant
HERO_VECTOR_DSN=postgresql://heroquant:heroquant@100.114.54.26:5432/heroquant
# billing 复用 checkpoint 库必须显式打开；未设时 _billing_dsn_from_env 返回 None（fail-closed）
HERO_BILLING_ALLOW_SHARED_DB=
# billing 内存降级开关（settings.py billing_allow_memory）：默认未设=false，即无 DSN 直接显式不可用；
# 显式 1/true/yes/on 才允许无 PG 走进程内存储，且响应必须带 degraded:true + reason:"billing:memory"
HERO_BILLING_ALLOW_MEMORY=
HERO_CHECKPOINT_TTL_SECONDS=604800

# Redis（限流 / ticket / 分布式锁；未配置时 infra/redis.py 走 fail-closed）
# 优先级：HERO_REDIS_DSN > HERO_REDIS_HOST/PORT/PASSWORD/DB > REDIS_URL
# 宿主与容器通用：100.114.54.26（本机 tailscale IP）；127.0.0.1:6379 不通。
HERO_REDIS_DSN=redis://100.114.54.26:6379/0
HERO_REDIS_HOST=100.114.54.26
HERO_REDIS_PORT=6379
HERO_REDIS_PASSWORD=
HERO_REDIS_DB=0

# 向量存储（pgvector 需要真 PG；off 时走内存回退）
HERO_VECTOR_STORE=
HERO_VECTOR_ENABLED=
HERO_EMBED_PROVIDER=offline
HERO_VECTOR_DIM=32

# 其他
# 运行时数据根目录：memory/（持久记忆）与 dedup.db（工具幂等账本）
HERO_DATA_DIR=data
HERO_BENCHMARK_TICKER=
HERO_WALL_TIME_BUDGET_SECONDS=30
FRONTEND_DIST=frontend/dist

# 身份 / OIDC（W1）
# HERO_AUTH_MODE：off=迁移期关闭强制鉴权；enforce=强制 Bearer（非法值也按 enforce）。
# auth_enabled() 还要求 issuer/audience 同时存在，缺配置时开发环境不会被强制鉴权打穿。
# 生产 issuer 形如 https://sso.example.com/realms/hero（Keycloak realm）。
HERO_AUTH_MODE=enforce
HERO_OIDC_ISSUER=
HERO_OIDC_AUDIENCE=
# 留空按 Keycloak 约定自动推导：{issuer}/protocol/openid-connect/certs
HERO_OIDC_JWKS_URL=
HERO_OIDC_ALGORITHMS=RS256
HERO_OIDC_LEEWAY_SECONDS=60
HERO_OIDC_JWKS_TTL_SECONDS=300

# 租户配额（Redis 滑动窗口 + 日 token 预算；daily_token_budget<=0 表示不限 token）
HERO_TENANT_REQUESTS_PER_MINUTE=60
HERO_TENANT_DAILY_TOKEN_BUDGET=2000000

# 审计 / PII / 遥测（PR3-I）
# PII_ENCRYPTION_KEY 由 `python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'` 生成
PII_ENCRYPTION_KEY=
HERO_OTEL_MODE=disabled
OTEL_EXPORTER_OTLP_ENDPOINT=

# /ready 就绪语义（settings.py ready_cohere_fatal）
# 默认 false = 缺 COHERE_API_KEY 只 warning、/ready 不降级；显式 true（1/true/yes/on）才判为致命 degraded。
HERO_READY_COHERE_FATAL=false

# 密钥托管后端（PR-151 / docs/SECURITY-SECRETS.md）
# env = 进程环境 / .env 明文（当前唯一真实后端，人工轮换）；
# vault / kms = 已登记但本构建未实现，命中即抛 UnsupportedSecretsBackendError，不静默回落 env；
# 其它未知值 → ValueError（fail-closed）。
HERO_SECRETS_BACKEND=env
