# hero-quant 环境示例 — 复制为 .env 后填入真实密钥
# cp .env.example .env

# LLM
HERO_LLM_PROVIDER=openai
HERO_API_KEY=sk-...
HERO_LLM_MODEL=gpt-4o-mini
COHERE_API_KEY=

# 数据
HERO_DATA_MODE=live
HERO_DATA_MARKET=CN

# 存储 / PG（本地默认 localhost；compose 内主机名经 HERO_PG_HOST=postgres 切换，见 settings.py 网关）
# 口令与 docker-compose.yml 对齐（heroquant/heroquant）；显式 HERO_*_DSN 优先于 HERO_PG_HOST
HERO_PG_HOST=
POSTGRES_DSN=postgresql://heroquant:heroquant@localhost:5432/heroquant
CHECKPOINT_DSN=postgresql://heroquant:heroquant@localhost:5432/heroquant
BILLING_DSN=postgresql://heroquant:heroquant@localhost:5432/heroquant
HERO_CHECKPOINT_DSN=postgresql://heroquant:heroquant@localhost:5432/heroquant
HERO_BILLING_DSN=postgresql://heroquant:heroquant@localhost:5432/heroquant
HERO_VECTOR_DSN=postgresql://heroquant:heroquant@localhost:5432/heroquant

# 其他
HERO_WALL_TIME_BUDGET_SECONDS=30
FRONTEND_DIST=frontend/dist

# 审计 / PII / 遥测（PR3-I）
# PII_ENCRYPTION_KEY 由 `python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'` 生成
PII_ENCRYPTION_KEY=
HERO_OTEL_MODE=disabled
OTEL_EXPORTER_OTLP_ENDPOINT=
