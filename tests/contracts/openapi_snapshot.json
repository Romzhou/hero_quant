    "/v1/audit": {
      "get": {
        "description": "查询当前租户的审计事件（只读）。\n\n排序口径由 store 决定：给 `run_id` 走 `trace()`（时间正序，便于串联一条链路）；\n不给则走 `query()`（时间倒序，便于\"最近发生了什么\"）。响应恒回\n`{\"items\", \"count\", \"limit\", \"offset\"}`，item 原样透出 store 行（ts 由 FastAPI 序列化）。",
        "operationId": "query_audit_v1_audit_get",
        "parameters": [
          {
            "description": "给定即返回该链路全量事件（时间正序，等价 store.trace）",
            "in": "query",
            "name": "run_id",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "给定即返回该链路全量事件（时间正序，等价 store.trace）",
              "title": "Run Id"
            }
          },
          {
            "description": "按操作人过滤；租户恒取当前上下文，不接受覆盖",
            "in": "query",
            "name": "user_id",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "按操作人过滤；租户恒取当前上下文，不接受覆盖",
              "title": "User Id"
            }
          },
          {
            "description": "按 action 精确过滤，如 query.completed",
            "in": "query",
            "name": "action",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "按 action 精确过滤，如 query.completed",
              "title": "Action"
            }
          },
          {
            "description": "ISO 时间或日期（闭区间下界）",
            "in": "query",
            "name": "since",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "ISO 时间或日期（闭区间下界）",
              "title": "Since"
            }
          },
          {
            "description": "ISO 时间或日期（闭区间上界）",
            "in": "query",
            "name": "until",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "ISO 时间或日期（闭区间上界）",
              "title": "Until"
            }
          },
          {
            "description": "默认 100，硬上限 500（超出被夹到上限）",
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 100,
              "description": "默认 100，硬上限 500（超出被夹到上限）",
              "title": "Limit",
              "type": "integer"
            }
          },
          {
            "description": "偏移，<0 归 0；run_id 全链路模式一次返回，不分页",
            "in": "query",
            "name": "offset",
            "required": false,
            "schema": {
              "default": 0,
              "description": "偏移，<0 归 0；run_id 全链路模式一次返回，不分页",
              "title": "Offset",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Query Audit V1 Audit Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Query Audit"
      }
    },
