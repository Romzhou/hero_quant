# Version control & CI
.git/
.github/

# IDE & editor
.claude/
.vscode/
.editorconfig

# Python artifacts
.venv/
venv/
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
hero_quant.egg-info/
