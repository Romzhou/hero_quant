# Frontend build (built inside Docker, don't copy local)
frontend/dist/
frontend/node_modules/
frontend/tsconfig.tsbuildinfo
node_modules/
dist/
build/

# Tests & docs (not needed in production image)
tests/
docs/
assets/

# Project docs — keep README/LICENSE in image, ignore other root md
CLAUDE.md
CONTRIBUTING.md
/*.md
!README.md
!LICENSE
